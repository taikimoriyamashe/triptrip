{
  "_README": [
    "WebFetch を無効化せずに情報流出リスクを下げるための設定例。",
    "考え方: リスク = (読める秘密) x (出せる経路) x (実行できる操作) の積。",
    "WebFetch を塞ぐのは真ん中の 1 項目だけで、しかも Bash の curl で迂回できる。",
    "そこで経路は開けたまま、両端の 2 項目を絞る。",
    "配布は managed-settings.json、検証は .claude/settings.json で行う。",
    "パス指定の書式は環境により異なるため、PoC 端末で実際に拒否されることを確認すること。"
  ],

  "permissions": {
    "defaultMode": "ask",
    "disableBypassPermissionsMode": true,

    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa*)",
      "Read(./**/credentials*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",

      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)"
    ],

    "ask": [
      "Bash(rm:*)",
      "Bash(git push:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(sudo:*)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/share/claude-guard/webfetch_guard.py",
            "timeout": 10,
            "statusMessage": "接続先を確認しています"
          }
        ]
      }
    ]
  },

  "env": {
    "WEBFETCH_GUARD_MODE": "detect"
  }
}
